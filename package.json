{
  "name": "@webnotes/figures",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./math": {
      "types": "./src/math/index.ts",
      "import": "./dist/math.js",
      "default": "./dist/math.js"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./render/server": {
      "types": "./src/render/server.ts",
